{
  "name": "@ayushkumar320/codebuddy",
  "version": "0.1.1",
  "description": "MCP memory server for multi-agent systems, powered by Postgres, pgvector, and Hugging Face.",
  "type": "module",
  "license": "MIT",
  "author": "Ayush Kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushkumar320/CodeBuddy"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codebuddy": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph/index.d.ts",
      "import": "./dist/langgraph/index.js"
    }
  },
  "files": [
    "dist",
    "src/db/migrations",
    "README.md",
    "CLAUDE_CODEX.md",
    "ARCHITECTURE.md",
    "WORKFLOW.md",
    "LICENSE",
    "docker-compose.yml",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "memory",
    "agent",
    "multi-agent",
    "huggingface",
    "pgvector",
    "postgres",
    "langgraph",
    "claude"
  ],
  "homepage": "https://github.com/ayushkumar320/CodeBuddy",
  "bugs": {
    "url": "https://github.com/ayushkumar320/CodeBuddy/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@huggingface/inference": "^4.13.19",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "commander": "^14.0.0",
    "drizzle-orm": "^0.45.2",
    "js-tiktoken": "^1.0.21",
    "langsmith": "^0.7.10",
    "ora": "^8.2.0",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "p-timeout": "^6.1.4",
    "picocolors": "^1.1.1",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "postgres": "^3.4.7",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@langchain/langgraph": "^0.2.0 || ^0.3.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
