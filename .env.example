# ─────────────────────────────────────────────────────────────
# CodeBuddy environment configuration
# Copy this file to `.env` and fill in real values for local dev.
# Never commit `.env` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Hugging Face ────────────────────────────────────────────
# Required for embedding + LLM calls via the provider layer.
# Get a token at https://huggingface.co/settings/tokens.
# Per /.rules, HF_TOKEN is the preferred auth source over the config file.
HF_TOKEN=hf_replace_me

# ── Postgres ────────────────────────────────────────────────
# Postgres 16+ with the `pgvector` extension enabled.
# The CodeBuddy SDK reads its postgresUrl from config; CLI/tools
# default to this env var when no explicit value is supplied.
DATABASE_URL=postgres://codebuddy:codebuddy@localhost:5432/codebuddy

# Optional: connection pool ceiling for the postgres-js client.
# Defaults to 10 when unset.
# DATABASE_MAX_CONNECTIONS=10

# ── LangSmith tracing (optional) ────────────────────────────
# Set LANGCHAIN_TRACING_V2=true (or LANGSMITH_TRACING=true) to enable
# planner + provider span emission. Without an API key the tracer falls
# back to structured stderr logs.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_replace_me
# LANGCHAIN_PROJECT=codebuddy-local
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Runtime ─────────────────────────────────────────────────
# NODE_ENV silences the tracer's stderr writes during tests.
# Leave unset locally; set to "production" when deploying.
# NODE_ENV=development

# ── Worker tuning (optional) ────────────────────────────────
# These are typically passed via CodeBuddyConfig.worker, not env.
# Documented here so ops know which knobs exist.
# CODEBUDDY_WORKER_POLL_MS=250
# CODEBUDDY_WORKER_BATCH_SIZE=8
# CODEBUDDY_WORKER_MAX_ATTEMPTS=5
