# CodeBuddy launch environment
# Copy to .env and replace HF_TOKEN before running live memory flows.

# Required: Hugging Face token for embeddings and model diagnostics.
HF_TOKEN=hf_replace_me

# Local Docker database from docker-compose.yml.
DATABASE_URL=postgres://codebuddy:codebuddy@localhost:5432/codebuddy

# Default namespace used by CLI and MCP when a command does not specify one.
CODEBUDDY_NAMESPACE=default

# Runtime.
NODE_ENV=development
LOG_LEVEL=info

# Optional LangSmith tracing.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_replace_me
# LANGCHAIN_PROJECT=codebuddy-local
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
